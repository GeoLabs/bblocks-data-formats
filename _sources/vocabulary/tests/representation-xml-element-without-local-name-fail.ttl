# Must fail: a representation whose XML Schema element has no local name. It realizes a real data
# type version and points to a real format, so only df:XmlSchemaElementShape can reject it (seen
# through df:RepresentationShape, which applies it to df:xmlSchemaElement).
@prefix df:   <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix dt:   <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/geolabs/ospd/data-formats/representation/xml-element-without-local-name> a df:Representation ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/representation/xml-element-without-local-name"^^xsd:anyURI ;
    rim:itemClass df:representationItemClass ;
    rim:inRegister df:register ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/curve/v1> ;
    df:format <https://w3id.org/geolabs/ospd/data-formats/format/gml> ;
    df:xmlSchemaElement [ df:xmlNamespace <http://www.opengis.net/gml/3.2> ;
        dct:source <https://schemas.opengis.net/gml/3.2.1/geometryPrimitives.xsd> ] ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/xml-element-without-local-name/actions/addition> .

<https://w3id.org/geolabs/ospd/data-formats/representation/xml-element-without-local-name/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer df:geolabs .
