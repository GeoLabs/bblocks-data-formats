# Must fail: otherwise valid, but the principal media type is none of the format's recorded media
# types, so nothing gives its source. Only df:PrimaryMediaTypeShape can reject it.
@prefix df:   <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix dt:   <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/geolabs/ospd/data-formats/format/fixture-primary-media-type-without-record> a df:Format ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/fixture-primary-media-type-without-record"^^xsd:anyURI ;
    rim:itemClass df:formatItemClass ;
    rim:inRegister df:register ;
    dct:conformsTo <https://docs.ogc.org/is/18-062r2/18-062r2.html> ;
    df:jsonSchemaFragment "{\"type\":\"object\"}"^^rdf:JSON ;
    df:primaryMediaType "application/geo+json" ;
    df:inferredMediaType [ df:mediaType "application/json" ;
        dct:source <https://docs.ogc.org/is/18-062r2/18-062r2.html> ;
        dct:description "Inferred from the JSON schema of the format."@en ] ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/fixture-primary-media-type-without-record/actions/addition> .

<https://w3id.org/geolabs/ospd/data-formats/format/fixture-primary-media-type-without-record/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer df:geolabs .
