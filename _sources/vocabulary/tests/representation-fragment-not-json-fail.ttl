# Must fail: a representation whose JSON Schema fragment is a plain string, not an rdf:JSON literal.
# It realizes a real data type version and points to a real format, so only the fragment constraint
# of df:RepresentationShape can reject it.
@prefix df:   <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix dt:   <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/geolabs/ospd/data-formats/representation/fragment-not-json> a df:Representation ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/representation/fragment-not-json"^^xsd:anyURI ;
    rim:itemClass df:representationItemClass ;
    rim:inRegister df:register ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/point/v1> ;
    df:format <https://w3id.org/geolabs/ospd/data-formats/format/geojson> ;
    df:jsonSchemaFragment "https://geojson.org/schema/Point.json" ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/fragment-not-json/actions/addition> .

<https://w3id.org/geolabs/ospd/data-formats/representation/fragment-not-json/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer df:geolabs .
