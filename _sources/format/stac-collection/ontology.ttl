@prefix df:   <https://w3id.org/geolabs-ospd/data-formats/> .
@prefix dt:   <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/geolabs-ospd/data-formats/format/stac-collection> a df:Format, rim:RegisterItem ;
    dct:title "STAC Collection"@en ;
    dct:description "A JSON object describing a set of related STAC Items, with its license, its spatial and temporal extents and its links."@en ;
    rim:objectIdentifier "https://w3id.org/geolabs-ospd/data-formats/format/stac-collection"^^xsd:anyURI ;
    rim:itemClass df:formatItemClass ;
    rim:inRegister df:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs-ospd/data-formats/format/stac-collection/actions/addition> ;
    dct:conformsTo <https://github.com/radiantearth/stac-spec/blob/v1.1.0/collection-spec/collection-spec.md> ;
    df:primaryMediaType "application/json" ;
    df:jsonSchemaFragment "{\"$ref\":\"https://schemas.stacspec.org/v1.1.0/collection-spec/json-schema/collection.json\"}"^^rdf:JSON ;
    df:inferredMediaType [ df:mediaType "application/json" ;
        dct:source <https://github.com/radiantearth/stac-spec/blob/v1.1.0/collection-spec/collection-spec.md> ;
        dct:description "Stated by the STAC Collection Specification 1.1.0, section Media Type for STAC Collections: \"A STAC Collection is a JSON file (RFC 8259), and thus should use the application/json as the Media Type (previously known as the MIME Type).\" Not observed in an Implementation Profile or on the testbed (measured on 2026-11-11, bblocks-process-profiles-tests-1 3d8c031): no process takes or returns a STAC Collection."@en ] ;
    rdfs:seeAlso <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/markdown/contrib/stac/collection-v1-1-0/index.md> ;
    rim:supersedes <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/item> .

<https://github.com/radiantearth/stac-spec/blob/v1.1.0/collection-spec/collection-spec.md> dct:title "STAC Collection Specification 1.1.0" .

<https://w3id.org/geolabs-ospd/data-formats/format/stac-collection/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer df:geolabs ;
    rim:appliesTo <https://w3id.org/geolabs-ospd/data-formats/format/stac-collection> ;
    prov:startedAtTime "2026-11-11T00:00:00Z"^^xsd:dateTime .
