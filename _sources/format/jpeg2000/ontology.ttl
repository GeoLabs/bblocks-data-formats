<https://w3id.org/geolabs/ospd/data-formats/format/jpeg2000> a df:Format, rim:RegisterItem ;
    dct:title "JPEG 2000"@en ;
    dct:description "A wavelet-based image encoding, lossless or lossy, of one or more components, in the JP2 file format."@en ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/jpeg2000"^^xsd:anyURI ;
    rim:itemClass df:formatItemClass ;
    rim:inRegister df:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/jpeg2000/actions/addition> ;
    dct:conformsTo <https://www.itu.int/rec/T-REC-T.800> ;
    df:observedMediaType [ df:mediaType "image/jp2" ; df:observedIn "testbed" ] .

<https://www.itu.int/rec/T-REC-T.800> dct:title "ITU-T Recommendation T.800, Information technology - JPEG 2000 image coding system: Core coding system" .

<https://w3id.org/geolabs/ospd/data-formats/format/jpeg2000/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/jpeg2000> ;
    prov:startedAtTime "2026-11-18T00:00:00Z"^^xsd:dateTime .
