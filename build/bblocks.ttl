            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://geolabs.github.io/bblocks-data-formats/build/annotated/format/geojson/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
