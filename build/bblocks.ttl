    dct:created "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geolabs.github.io/bblocks-data-formats/build/generateddocs/markdown/format/geojson/index.md> ],
        [ dct:format "text/html" ;
