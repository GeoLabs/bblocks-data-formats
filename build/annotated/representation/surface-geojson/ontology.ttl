@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-formats/representation/surface-geojson> a df:Representation,
        rim:RegisterItem ;
    dct:title "Surface as GeoJSON"@en ;
    df:format <https://w3id.org/geolabs/ospd/data-formats/format/geojson> ;
    df:jsonSchemaFragment "{\"oneOf\":[{\"$ref\":\"https://geojson.org/schema/Polygon.json\"},{\"$ref\":\"https://geojson.org/schema/MultiPolygon.json\"}]}"^^rdf:JSON ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/surface-geojson/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:representationItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/representation/surface-geojson"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/surface/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/representation/surface-geojson/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/representation/surface-geojson> ;
    rim:proposer df:geolabs .

