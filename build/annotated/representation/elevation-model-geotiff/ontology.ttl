@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-formats/representation/elevation-model-geotiff> a df:Representation,
        rim:RegisterItem ;
    dct:title "Elevation model as GeoTIFF"@en ;
    df:format <https://w3id.org/geolabs/ospd/data-formats/format/geotiff> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/elevation-model-geotiff/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:representationItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/representation/elevation-model-geotiff"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/representation/elevation-model-geotiff/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/representation/elevation-model-geotiff> ;
    rim:proposer df:geolabs .

