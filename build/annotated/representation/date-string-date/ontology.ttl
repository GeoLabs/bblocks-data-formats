@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-formats/representation/date-string-date> a df:Representation,
        rim:RegisterItem ;
    dct:title "Date as Date string"@en ;
    df:format <https://w3id.org/geolabs/ospd/data-formats/format/string-date> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/date-string-date/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:representationItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/representation/date-string-date"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/date/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/representation/date-string-date/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-18T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/representation/date-string-date> ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

