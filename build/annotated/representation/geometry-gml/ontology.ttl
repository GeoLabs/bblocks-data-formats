@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml> ;
    rim:proposer df:geolabs .

<https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml/actions/amendment-has-format> a rim:RegisterAction ;
    dct:description "The block of this representation now names geometry-geojson, the other representation of the same data type (geometry, version 1), with hasFormat, added on 2026-11-10 with geometry-geojson, the first data type with two representations (decision D6). The item, its data type and its format are unchanged. Classified clarifying: a documentary link, which changes neither what the item means nor what a register user must do."@en ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType df:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer df:geolabs .

<https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml/actions/amendment-xml-schema-element-2026-11-17> a rim:RegisterAction ;
    dct:description "XML Schema element named (df:xmlSchemaElement): gml:AbstractGeometry, namespace http://www.opengis.net/gml/3.2, declared in https://schemas.opengis.net/gml/3.2.1/geometryBasic0d1d.xsd (GML 3.2.1, the version the gml format names since 2026-11-17). It is abstract: a GML geometry is any element of its substitution group. Decision of Gérald, 2026-11-17. The realized data type version and the format are unchanged. Classified substantive: the element is the schema of the data type in this format."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType df:amendmentAction ;
    rim:affectedProperty df:xmlSchemaElement ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer df:geolabs .

<https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml> a df:Representation,
        rim:RegisterItem ;
    dct:title "Geometry as GML"@en ;
    df:format <https://w3id.org/geolabs/ospd/data-formats/format/gml> ;
    df:xmlSchemaElement [ dct:source <https://schemas.opengis.net/gml/3.2.1/geometryBasic0d1d.xsd> ;
            df:xmlLocalName "AbstractGeometry" ;
            df:xmlNamespace <http://www.opengis.net/gml/3.2> ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml/actions/addition>,
        <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml/actions/amendment-has-format>,
        <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml/actions/amendment-xml-schema-element-2026-11-17> ;
    rim:inRegister df:register ;
    rim:itemClass df:representationItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/geometry/v1> ;
    rim:validityStatus rim:invalid .

