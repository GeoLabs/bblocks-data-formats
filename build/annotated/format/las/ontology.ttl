@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-formats/format/las> a df:Format,
        rim:RegisterItem ;
    dct:conformsTo <https://www.ogc.org/standards/las/> ;
    dct:description "A binary encoding of point cloud records."@en ;
    dct:title "LAS"@en ;
    df:observedMediaType [ df:mediaType "application/vnd.las" ;
            df:observedIn "implementation-profile" ],
        [ df:mediaType "application/x-ogc-lasf" ;
            df:observedIn "testbed" ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/las/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:formatItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/las"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/format/las/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/las> ;
    rim:proposer df:geolabs .

<https://www.ogc.org/standards/las/> dct:title "OGC 17-030r1 LAS Specification 1.4 OGC Community Standard" .

