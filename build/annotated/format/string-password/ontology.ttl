<https://spec.openapis.org/oas/v3.0.3#data-types> dct:title "OpenAPI Specification 3.0.3, Data Types" .

<https://w3id.org/geolabs/ospd/data-formats/format/string-password> a df:Format,
        rim:RegisterItem ;
    dct:conformsTo <https://spec.openapis.org/oas/v3.0.3#data-types> ;
    dct:description "A password, as the OpenAPI `password` format: a hint to obscure the value."@en ;
    dct:source <https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml> ;
    dct:title "Password string"@en ;
    rdfs:seeAlso <https://geolabs.github.io/bblocks-eoap-cct/bblock/eoap.cct.string-format> ;
    df:cwlCustomType "Password" ;
    df:jsonSchemaFragment "{\"format\":\"password\",\"type\":\"string\"}"^^rdf:JSON ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/string-password/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:formatItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/string-password"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:supersedes <https://geolabs.github.io/bblocks-data-types/def/data-type/string-password/item> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/format/string-password/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/string-password> ;
    rim:proposer df:geolabs .

