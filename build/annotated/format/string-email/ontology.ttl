@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://json-schema.org/draft/2020-12/json-schema-validation#section-7.3.2> dct:title "JSON Schema Validation: A Vocabulary for Structural Validation of JSON (draft 2020-12), 7.3.2 Email Addresses" .

<https://w3id.org/geolabs/ospd/data-formats/format/string-email> a df:Format,
        rim:RegisterItem ;
    dct:conformsTo <https://json-schema.org/draft/2020-12/json-schema-validation#section-7.3.2> ;
    dct:description "An email address, as JSON Schema `email`."@en ;
    dct:source <https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml> ;
    dct:title "Email address string"@en ;
    rdfs:seeAlso <https://geolabs.github.io/bblocks-eoap-cct/bblock/eoap.cct.string-format> ;
    df:cwlCustomType "Email" ;
    df:jsonSchemaFragment "{\"format\":\"email\",\"type\":\"string\"}"^^rdf:JSON ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/string-email/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:formatItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/string-email"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:supersedes <https://geolabs.github.io/bblocks-data-types/def/data-type/string-email/item> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/format/string-email/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/string-email> ;
    rim:proposer df:geolabs .

