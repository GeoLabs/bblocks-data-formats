@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson> ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson/actions/amendment-primary-media-type-2026-11-17> a rim:RegisterAction ;
    dct:description "Principal media type set (df:primaryMediaType): application/geo+json, the media type already recorded from the specification (df:inferredMediaType). OGC 17-003r2, chapter 9, says the listed media types shall be used when EO Dataset Metadata is delivered over HTTP, and gives application/geo+json for the GeoJSON representation, the encoding this format describes; its two application/ld+json rows are the GeoJSON-LD representations, which are not this format. application/geo+json is the media type RFC 7946 registers for GeoJSON. Checked on 2026-11-17 in https://docs.ogc.org/is/17-003r2/17-003r2.html. Decision of Gérald, 2026-11-17. The specification, the recorded media type and the JSON Schema fragment are unchanged. Classified substantive: the register specification lists the principal media type among the substantive changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType df:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://docs.ogc.org/is/17-003r2/17-003r2.html> dct:title "OGC 17-003r2 EO Dataset Metadata GeoJSON(-LD) Encoding Standard 1.0" .

<https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson> a df:Format ;
    dct:conformsTo <https://docs.ogc.org/is/17-003r2/17-003r2.html> ;
    df:inferredMediaType [ dct:description "Stated by OGC 17-003r2, chapter 9, Media Types for any data encoding(s): \"When EO Dataset Metadata is delivered using HTTP, the following MIME media types shall be used.\" The table gives application/geo+json for the \"GeoJSON representation with implicit normative context or normative context linked via a http://www.w3.org/ns/json-ld#context HTTP Link Header\"; its two other rows are the GeoJSON-LD representations (application/ld+json, with or without a profile parameter), which are not this format. Read on 2026-11-17. Not observed in an Implementation Profile or on the testbed: no role uses this format yet." ;
            dct:source <https://docs.ogc.org/is/17-003r2/17-003r2.html> ;
            df:mediaType "application/geo+json" ] ;
    df:jsonSchemaFragment "{\"$ref\":\"https://schemas.opengis.net/eo-geojson/1.0/eo-geojson-schema.json\"}"^^rdf:JSON ;
    df:primaryMediaType "application/geo+json" ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson/actions/addition>,
        <https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson/actions/amendment-primary-media-type-2026-11-17> ;
    rim:inRegister df:register ;
    rim:itemClass df:formatItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/eo-geojson"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

