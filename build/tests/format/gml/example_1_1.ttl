@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.opengis.net/doc/IS/GML/3.2.1> dct:title "OGC 07-036 Geography Markup Language (GML) Encoding Standard 3.2.1 (ISO 19136:2007)" .

<https://w3id.org/geolabs/ospd/data-formats/format/gml/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/gml> ;
    rim:proposer df:geolabs .

<https://w3id.org/geolabs/ospd/data-formats/format/gml/actions/amendment-gml-3-2-1-2026-11-17> a rim:RegisterAction ;
    dct:description "Specification made precise (dct:conformsTo): OGC 07-036 Geography Markup Language (GML) Encoding Standard 3.2.1 (ISO 19136:2007), http://www.opengis.net/doc/IS/GML/3.2.1, instead of the unversioned OGC GML page https://www.ogc.org/standards/gml/. Its XML Schemas are published at https://schemas.opengis.net/gml/3.2.1/ (gml.xsd declares version 3.2.2), target namespace http://www.opengis.net/gml/3.2. The representations of this format name their XML Schema element there (df:xmlSchemaElement). No version was established when the format was added: the Implementation Profiles said GML only and the testbed contentSchema values (http://fooa/gml/3.1.0/...) are on a placeholder host. Decision of Gérald, 2026-11-17. The observed media types are unchanged. Classified substantive: the register specification lists the version of the specification among the substantive changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType df:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/gml> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer df:geolabs .

<https://w3id.org/geolabs/ospd/data-formats/format/gml> a df:Format ;
    dct:conformsTo <http://www.opengis.net/doc/IS/GML/3.2.1> ;
    df:observedMediaType [ df:mediaType "text/xml" ;
            df:observedIn "implementation-profile" ],
        [ df:mediaType "text/xml" ;
            df:observedIn "testbed" ] ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/gml/actions/addition>,
        <https://w3id.org/geolabs/ospd/data-formats/format/gml/actions/amendment-gml-3-2-1-2026-11-17> ;
    rim:inRegister df:register ;
    rim:itemClass df:formatItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/gml"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

