@prefix dct: <http://purl.org/dc/terms/> .
@prefix df: <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://json-schema.org/draft/2020-12/json-schema-validation#section-7.3.1> dct:title "JSON Schema Validation: A Vocabulary for Structural Validation of JSON (draft 2020-12), 7.3.1 Dates, Times, and Duration" .

<https://w3id.org/geolabs/ospd/data-formats/format/string-time> a df:Format ;
    dct:conformsTo <https://json-schema.org/draft/2020-12/json-schema-validation#section-7.3.1> ;
    rdfs:seeAlso <https://geolabs.github.io/bblocks-eoap-cct/bblock/eoap.cct.string-format> ;
    df:cwlCustomType "Time" ;
    df:jsonSchemaFragment "{\"format\":\"time\",\"type\":\"string\"}"^^rdf:JSON ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/string-time/actions/addition> ;
    rim:inRegister df:register ;
    rim:itemClass df:formatItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/string-time"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:supersedes <https://geolabs.github.io/bblocks-data-types/def/data-type/string-time/item> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-formats/format/string-time/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/string-time> ;
    rim:proposer df:geolabs .

