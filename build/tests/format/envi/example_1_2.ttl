@prefix df:   <https://w3id.org/geolabs/ospd/data-formats/> .
@prefix dt:   <https://w3id.org/geolabs/ospd/data-types/> .
@prefix rim:  <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .


<https://w3id.org/geolabs/ospd/data-formats/format/envi> a df:Format, rim:RegisterItem ;
    dct:title "ENVI .hdr labelled raster"@en ;
    dct:description "Raw raster cells, band interleaved by line, by pixel or band sequential, described by an ENVI-style .hdr text header."@en ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-formats/format/envi"^^xsd:anyURI ;
    rim:itemClass df:formatItemClass ;
    rim:inRegister df:register ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/format/envi/actions/addition> ;
    dct:conformsTo <https://gdal.org/en/stable/drivers/raster/envi.html> ;
    df:observedMediaType [ df:mediaType "application/x-ogc-envi" ; df:observedIn "testbed" ] .

<https://gdal.org/en/stable/drivers/raster/envi.html> dct:title "GDAL raster driver documentation: ENVI -- ENVI .hdr Labelled Raster" .

<https://w3id.org/geolabs/ospd/data-formats/format/envi/actions/addition> a rim:RegisterAction ;
    rim:actionType rim:additionAction ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-formats/format/envi> ;
    prov:startedAtTime "2026-11-18T00:00:00Z"^^xsd:dateTime .
