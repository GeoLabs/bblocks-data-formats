    df:jsonSchemaFragment "{\"$ref\":\"https://geojson.org/schema/Polygon.json\"}"^^rdf:JSON ;
    rim:validityStatus rim:invalid ;
    rim:publicationStatus rim:published ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-formats/representation/polygon-geojson/actions/addition> .

